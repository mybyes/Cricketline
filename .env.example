# Copy to apps/backend/.env for local backend, or use with docker-compose.
# Demo works with SEED_DATA=1 and no CricAPI key.

SEED_DATA=1
# memory:// = no Docker needed for local seed/demo; use redis://localhost:6379 when Redis is up
UPSTASH_REDIS_URL=memory://
DATABASE_URL=postgres://cricketfast:cricketfast@localhost:5432/cricketfast
PORT=3000

# Leave unset (or remove SEED_DATA) and set a real key for live scores.
# CRICAPI_KEY=
# CRICAPI_KEYS=key1,key2

# Push / wicket alerts — off by default.
# PUSH_ENABLED=0

# Display-only odds feed (optional). Unset = seed simulated markets in demo mode.
# ODDS_API_URL=https://your-licensed-feed.example/v1
# ODDS_API_KEY=
