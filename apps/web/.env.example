# Server-side fetch (Vercel → Railway). Locally you can point at localhost.
API_URL=https://backend-production-233f.up.railway.app
# API_URL=http://localhost:3000

# Browser-facing API (optional; defaults follow API_URL / relative proxy in some setups)
NEXT_PUBLIC_API_URL=https://backend-production-233f.up.railway.app

# Canonical site URL for SEO (sitemap, robots, Open Graph, JSON-LD).
# Own a domain, then set it here + in Vercel. Until then use the Vercel host.
NEXT_PUBLIC_SITE_URL=https://cricketline-mybyes.vercel.app

# Optional: Google Sign-In (Web). Leave blank to hide auth.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: Play Store listing (download CTA + SoftwareApplication JSON-LD).
# NEXT_PUBLIC_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=com.cricketpulse.app
