{
  "expo": {
    "name": "Cricket Pulse",
    "slug": "cricketpulse",
    "owner": "mybyess-team",
    "version": "1.0.0",
    "description": "Cricket Pulse – Live Line & AI. Live scores, display-only match odds & session markets, scorecard, squads & points table. Free, no login.",
    "scheme": "cricketpulse",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cricketpulse.app"
    },
    "android": {
      "package": "com.cricketpulse.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Cricket Pulse – Live Line & AI",
      "shortName": "Cricket Pulse",
      "description": "Live cricket line & markets — odds, session, scorecard. Display-only. Free, no login.",
      "themeColor": "#0B1220",
      "backgroundColor": "#F2EFE6",
      "display": "standalone",
      "lang": "en",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0B1220",
          "icon": "./assets/icon.png"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B1220"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "3957cd95-ebb3-42f4-8c68-27148cefb64e"
      }
    }
  }
}
